#!/bin/sh /etc/rc.common
# procd 服务: RTSP 回看代理 + 内置定时生成
START=99
USE_PROCD=1

PROG=/usr/bin/iptv-helper

start_service() {
	local mode
	config_load iptv-helper
	config_get mode main mode daemon
	procd_open_instance
	procd_set_param command "$PROG" -c /etc/config/iptv-helper "$mode"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}
