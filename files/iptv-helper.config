# /etc/config/iptv-helper — 全部业务参数(无硬编码,按抓包修改)
config iptv-helper 'main'
	# 运行模式: daemon(代理+定时生成) / proxy(仅代理)
	option mode 'daemon'
	# EPG 服务器(鉴权/频道/节目单)
	option epg_host ''
	option epg_port '80'
	option auth_path '/EPG/jsp/ValidAuthenticationHWCTC.jsp'
	option channellist_path '/EPG/jsp/getchannellistHWCTC.jsp'
	option logo_path '/VSP/V3/QueryPlaybillContext'
	option playbill_path '/VSP/V3/QueryPlaybillList'

	# 鉴权表单(抓包获得,原样填入)
	option UserID ''
	option Lang '1'
	option SupportHD '1'
	option NetUserID ''
	option Authenticator ''
	option STBType ''
	option STBVersion ''
	option conntype '4'
	option STBID ''
	option templateName ''
	option areaId ''
	option userToken ''
	option userGroupId '1'
	option productPackageId '-1'
	option mac ''
	option UserField '2'
	option SoftwareVersion ''
	option IsSmartStb '0'
	option desktopId ''
	option stbmaker ''
	option XMPPCapability '1'
	option ChipID ''
	option VIP ''

	# RTSP 边缘服务器(回看源)
	option edge_host ''
	option edge_port '554'
	# 本机回看代理监听端口
	option rtsp_port '554'
	# 内网回看地址走代理(proxy)还是直连边缘(direct)
	option replay_via 'proxy'
	# LanReplay.m3u 是否带回看时间戳(catchup-source)
	option lan_catchup '1'

	# 直播基址(udpxy,OpenWrt 可自装 udpxy 包)
	option udpxy_lan 'http://127.0.0.1:4022'
	option udpxy_pub ''
	# 外网回看基址(指向本机 554 的域名端口映射)
	option replay_pub ''
	# 生成的文件对外访问基址(uhttpd 默认 80 口)
	option http_pub_base ''

	# 输出目录(uhttpd web 根下,可直接下载)
	option out_dir '/www/iptv'
	option lanlive_file 'LanLive.m3u'
	option lanreplay_file 'LanReplay.m3u'
	option netlive_file 'NetLive.m3u'
	option netreplay_file 'NetReplay.m3u'
	option txt_file 'channels.txt'
	option epg_file 'PL.xml'
	option epg_name 'IPTV EPG'
	# 回看 catchup 参数模板(多值,播放器按顺序尝试;支持 playseek/starttime 等)
	list catchup_params 'playseek=${(b)yyyyMMddHHmmss}-${(e)yyyyMMddHHmmss}'
	list catchup_params 'starttime=${(b)yyyyMMddHHmmss}-${(e)yyyyMMddHHmmss}'
	option catchup_fmt 'yyyyMMddHHmmss'

	# 定时生成(cron 也可,二选一),空格分隔多个 HH:MM
	list schedule '01:00'
	list schedule '13:00'
	# 节目单:回看历史天数 / 每频道请求轮数
	option history_days '6'
	option playbill_rounds '8'
	# 是否抓取台标
	option fetch_logo '1'

	# 本机 IP(留空自动探测)与探测目标
	option lan_ip ''
	option lan_probe_host '223.5.5.5'
	option lan_probe_port '53'
