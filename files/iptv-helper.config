# /etc/config/iptv-helper — 全部业务参数(无硬编码,按抓包修改)
config iptv-helper 'main'
	# 运行模式: daemon(代理+定时生成) / proxy(仅代理)
	option mode 'daemon'
	# EPG 服务器(鉴权/频道/节目单)
	option epg_host ''
	option epg_port '80'
	option auth_path '/EPG/jsp/ValidAuthenticationHWCTC.jsp'
	option channellist_path '/EPG/jsp/getchannellistHWCTC.jsp'
	option logo_path '/VSP/V3/QueryPlaybillContext'
	option playbill_path '/VSP/V3/QueryPlaybillList'

	# 鉴权表单(抓包获得,原样填入)
	#   NetUserID / desktopId / stbmaker / ChipID / VIP 不再在 LuCI 显示,
	#   程序中恒以空值提交(旧配置里即使残留了值也不会生效)
	option UserID ''
	option Lang '1'
	option SupportHD '1'
	option Authenticator ''
	option STBType ''
	option STBVersion ''
	option conntype '4'
	option STBID ''
	option templateName ''
	option areaId ''
	option userToken ''
	option userGroupId '1'
	option productPackageId '-1'
	option mac ''
	option UserField '2'
	option SoftwareVersion ''
	option IsSmartStb '0'
	option XMPPCapability '1'

	# RTSP 边缘服务器(回看源)
	option edge_host ''
	option edge_port '554'
	# 本机回看代理监听端口
	option rtsp_port '554'
	# 内网回看地址走代理(proxy)还是直连边缘(direct)
	option replay_via 'proxy'
	# LanReplay.m3u 是否带回看时间戳(catchup-source)
	option lan_catchup '1'

	# 直播基址(udpxy,OpenWrt 可自装 udpxy 包)
	option udpxy_lan 'http://127.0.0.1:4022'
	option udpxy_pub ''
	# 外网回看基址(指向本机 554 的域名端口映射)
	option replay_pub ''
	# 生成的文件对外访问基址(uhttpd 默认 80 口)
	option http_pub_base ''

	# 输出目录(uhttpd web 根下,可直接下载)
	option out_dir '/www/iptv'
	option lanlive_file 'LanLive.m3u'
	option lanreplay_file 'LanReplay.m3u'
	option netlive_file 'NetLive.m3u'
	option netreplay_file 'NetReplay.m3u'
	option txt_file 'channels.txt'
	option epg_file 'PL.xml'
	option epg_name 'IPTV EPG'
	# 回看/时移 catchup:本项目的 #EXTINF 属性契约(播放器自定义,不依赖第三方约定)
	#   catchup_type: append(回看,参数追加在频道 URL 后,RTSP PLTV 用)
	#               / shift(时移,秒级时间戳) / default(HTTP/HLS,UTC+T) / flussonic / custom
	#   仅用于「旧式裸模板」的包装与 catchup_params 留空时的兜底;片段自带属性名时以片段为准
	option catchup_type 'append'
	# catchup_params: 每项是一段原样写入 #EXTINF 的属性片段,片段之间用单个空格连接。
	#   回看与时移是两套并列语义,属性名必须分开写(catchup / shift),否则同一行会出现重名属性、
	#   后者顶掉前者(旧版就是因此把 playseek 顶掉的):
	#     catchup="append" catchup-source="?playseek=${(b)yyyyMMddHHmmss}-${(e)yyyyMMddHHmmss}"
	#     shift="append"   shift-source="?starttime=${(b)yyyyMMddHHmmss}-${(e)yyyyMMddHHmmss}"
	#   两行同时保留 -> 播放器可同时提供「回看」与「时移」两个入口。
	#   想只留一种,删掉对应那一项即可。
	#   写法二(旧式裸模板): 不写属性名,只给模板本身,例如
	#     playseek=${(b)yyyyMMddHHmmss}-${(e)yyyyMMddHHmmss}
	#   写法和输出形态的区别(升级兼容点):
	#     - 多个裸模板会「合并成一条」catchup="<catchup_type>" catchup-source="?a or ?b",
	#       与 1.0.0 产物逐字节一致 —— 老配置升级后 m3u 语义不变。
	#     - 完整属性片段则「各自独立成组」,空格连接,因此 catchup/shift 可以并列共存。
	#   常用占位符:
	#     ${(b)yyyyMMddHHmmss} / ${(e)yyyyMMddHHmmss}   本地时间,格式串可换;结尾加 |UTC 则按 UTC
	#     {utc:yyyyMMddHHmmss} / {utcend:yyyyMMddHHmmss}  固定 UTC 写法
	#     {start} / {end}                                本地固定 yyyyMMddHHmmss
	#     ${timestamp} / ${end_timestamp} / ${duration}   秒级 Unix 时间戳 / 时长(秒)
	#   各类型兜底片段(仅当 catchup_params 为空时生效):
	#     append : catchup="append" catchup-source="?playseek=${(b)yyyyMMddHHmmss}-${(e)yyyyMMddHHmmss}"
	#     shift  : shift="shift" shift-source="?starttime=${(b)yyyyMMddHHmmss}-${(e)yyyyMMddHHmmss}"
	#     default: catchup="default" catchup-source="?starttime=${(b)yyyyMMdd|UTC}T${(b)HHmmss|UTC}&endtime=${(e)yyyyMMdd|UTC}T${(e)HHmmss|UTC}"
	#     flussonic: catchup="flussonic" catchup-source="?start=${timestamp}&duration=${duration}"
	list catchup_params 'catchup="append" catchup-source="?playseek=${(b)yyyyMMddHHmmss}-${(e)yyyyMMddHHmmss}"'
	list catchup_params 'shift="append" shift-source="?starttime=${(b)yyyyMMddHHmmss}-${(e)yyyyMMddHHmmss}"'
	option catchup_fmt 'yyyyMMddHHmmss'
	# 可选声明属性(留空/0 则不写入 #EXTINF)
	#   catchup_days  = 可回看天数声明
	#   timeshift_days= 可时移天数声明(部分播放器读此字段)
	#   catchup_correction = 时间偏移(如 -10800 表示减 3 小时)
	option catchup_days ''
	option timeshift_days ''
	option catchup_correction ''

	# 定时生成(cron 也可,二选一),空格分隔多个 HH:MM
	list schedule '01:00'
	list schedule '13:00'
	# 节目单:回看历史天数 / 每频道请求轮数
	option history_days '6'
	option playbill_rounds '8'
	# 是否抓取台标
	option fetch_logo '1'
	# 台标缓存到 <out_dir>/<logo_dir>/,m3u 的 tvg-logo 指向本地缓存(http_pub_base 下);
	# 下载失败或内容非图片时回退远端原始地址
	option cache_logo '1'
	option logo_dir 'logo'
	# 已缓存的台标直接复用,不重复下载(0 = 每次重新下载)
	option logo_reuse '1'

	# 本机 IP(留空自动探测)与探测目标
	option lan_ip ''
	option lan_probe_host '223.5.5.5'
	option lan_probe_port '53'
